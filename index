          <button onclick="copyHandle('yusufissinister', 'roblox-status')" id="roblox-status" class="text-[11px] mono text-[#737373] hover:text-[#e5e5e5] px-1.5 py-0.5 bg-[#0d0d0d] border border-[#262626] transition">
