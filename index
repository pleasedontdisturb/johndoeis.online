  </main>

  <script>
    /* =========================================================================
       STATE & CONFIGURATION
       ========================================================================= */
    const state = {
      mouseX: window.innerWidth / 2,
      mouseY: window.innerHeight / 2 - 120,
      laserActive: false,
      sfxEnabled: true,
      catSpeedMultiplier: 1.0,
      gridRadius: 120,
      petCount: 0,
      snacks: []
    };

    /* =========================================================================
       MINIMAL WEB AUDIO SYNTH (NO EXTERNAL FILES)
       ========================================================================= */
    let audioCtx = null;
    function getAudio() {
      if (!audioCtx) {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        audioCtx = new AudioContext();
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }

    function playClickTick(freq = 180) {
      if (!state.sfxEnabled) return;
      try {
        const ctx = getAudio();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(45, ctx.currentTime + 0.045);
        gain.gain.setValueAtTime(0.06, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.045);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.05);
      } catch (e) {}
    }

    function playPurrSynth() {
      if (!state.sfxEnabled) return;
      try {
        const ctx = getAudio();
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(28, now);
        osc.frequency.linearRampToValueAtTime(34, now + 0.18);
        osc.frequency.linearRampToValueAtTime(26, now + 0.35);

        gain.gain.setValueAtTime(0.001, now);
        gain.gain.linearRampToValueAtTime(0.04, now + 0.08);
        gain.gain.exponentialRampToValueAtTime(0.0008, now + 0.38);

        const filter = ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.value = 140;

        osc.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.4);
      } catch (e) {}
    }

    function playSoftChirp() {
      if (!state.sfxEnabled) return;
      try {
        const ctx = getAudio();
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(380, now);
        osc.frequency.exponentialRampToValueAtTime(620, now + 0.09);
        osc.frequency.exponentialRampToValueAtTime(440, now + 0.18);

        gain.gain.setValueAtTime(0.04, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.19);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.2);
      } catch (e) {}
    }

    /* =========================================================================
       1. BACKGROUND ASCII / DOT PHYSICS GRID
       ========================================================================= */
    const bgCanvas = document.getElementById('bg-canvas');
    const bgCtx = bgCanvas.getContext('2d');
    let gridPoints = [];
    let ripples = [];
    const GRID_SPACING = 28;

    function initGrid() {
      bgCanvas.width = window.innerWidth;
      bgCanvas.height = window.innerHeight;
      gridPoints = [];

      const cols = Math.ceil(bgCanvas.width / GRID_SPACING) + 1;
      const rows = Math.ceil(bgCanvas.height / GRID_SPACING) + 1;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const ox = c * GRID_SPACING;
          const oy = r * GRID_SPACING;
          gridPoints.push({
            ox, oy,
            x: ox, y: oy,
            vx: 0, vy: 0
          });
        }
      }
    }

    function spawnRipple(x, y, strength = 12) {
      ripples.push({
        x, y,
        radius: 0,
        maxRadius: Math.max(window.innerWidth, window.innerHeight) * 0.45,
        strength
      });
    }

    function updateAndDrawGrid() {
      bgCtx.clearRect(0, 0, bgCanvas.width, bgCanvas.height);
      bgCtx.font = '11px "JetBrains Mono", monospace';
      bgCtx.textAlign = 'center';
      bgCtx.textBaseline = 'middle';

      for (let i = ripples.length - 1; i >= 0; i--) {
        ripples[i].radius += 9;
        if (ripples[i].radius > ripples[i].maxRadius) {
          ripples.splice(i, 1);
        }
      }

      const radiusSq = state.gridRadius * state.gridRadius;

      for (let i = 0; i < gridPoints.length; i++) {
        const p = gridPoints[i];

        // Cursor repulsion + subtle swirl
        const dx = p.x - state.mouseX;
        const dy = p.y - state.mouseY;
        const distSq = dx * dx + dy * dy;

        if (distSq < radiusSq && distSq > 0.01) {
          const dist = Math.sqrt(distSq);
          const force = (1 - dist / state.gridRadius) * 1.65;
          const angle = Math.atan2(dy, dx);
          p.vx += Math.cos(angle + 0.25) * force;
          p.vy += Math.sin(angle + 0.25) * force;
        }

        // Cat paws disturbance when running
        const cdx = p.x - cat.x;
        const cdy = p.y - cat.y;
        const cDistSq = cdx * cdx + cdy * cdy;
        if (cDistSq < 3600 && (Math.abs(cat.vx) > 0.5 || Math.abs(cat.vy) > 0.5)) {
          const cDist = Math.sqrt(cDistSq) || 1;
          const cForce = (1 - cDist / 60) * 1.2;
          p.vx += (cdx / cDist) * cForce;
          p.vy += (cdy / cDist) * cForce;
        }

        // Click ripples
        for (let r = 0; r < ripples.length; r++) {
          const rip = ripples[r];
          const rdx = p.ox - rip.x;
          const rdy = p.oy - rip.y;
          const rDist = Math.sqrt(rdx * rdx + rdy * rdy);
          const band = Math.abs(rDist - rip.radius);
          if (band < 28) {
            const fade = 1 - rip.radius / rip.maxRadius;
            const push = (1 - band / 28) * rip.strength * fade * 0.35;
            const ang = Math.atan2(rdy, rdx);
            p.vx += Math.cos(ang) * push;
            p.vy += Math.sin(ang) * push;
          }
        }

        // Spring back to origin
        p.vx += (p.ox - p.x) * 0.085;
        p.vy += (p.oy - p.y) * 0.085;

        // Damping
        p.vx *= 0.82;
        p.vy *= 0.82;

        p.x += p.vx;
        p.y += p.vy;

        // Render dot or ASCII character depending on displacement energy
        const disp = Math.abs(p.x - p.ox) + Math.abs(p.y - p.oy);
        if (disp > 7) {
          bgCtx.fillStyle = '#525252';
          bgCtx.fillText('*', p.x, p.y);
        } else if (disp > 2.2) {
          bgCtx.fillStyle = '#363636';
          bgCtx.fillText('+', p.x, p.y);
        } else {
          bgCtx.fillStyle = '#222222';
          bgCtx.fillRect(p.x - 1, p.y - 1, 2, 2);
        }
      }
    }

    /* =========================================================================
       2. PHYSICS-DRIVEN CAT COMPANION & LASER POINTER
       ========================================================================= */
    const catCanvas = document.getElementById('cat-canvas');
    const catCtx = catCanvas.getContext('2d');
    const cardEl = document.getElementById('card-container');

    const cat = {
      x: 0,
      y: 0,
      vx: 0,
      vy: 0,
      facing: -1,
      mode: 'perched',
      blinkTimer: 120,
      isBlinking: false,
      petSquintTimer: 0,
      stretchFactor: 0,
      walkCycle: 0,
      pounceCooldown: 0,
      tail: [],
      initialized: false
    };

    function getPerchPosition() {
      const rect = cardEl.getBoundingClientRect();
      return {
        x: rect.right - 68,
        y: rect.top
      };
    }

    function initCat() {
      catCanvas.width = window.innerWidth;
      catCanvas.height = window.innerHeight;
      const perch = getPerchPosition();
      if (!cat.initialized) {
        cat.x = perch.x;
        cat.y = perch.y;
        cat.tail = [];
        for (let i = 0; i < 6; i++) {
          cat.tail.push({ x: cat.x + i * 7, y: cat.y - 4 });
        }
        cat.initialized = true;
      } else if (cat.mode === 'perched') {
        cat.x = perch.x;
        cat.y = perch.y;
      }
    }

    function updateCatPhysics(time) {
      const perch = getPerchPosition();
      const statusLabel = document.getElementById('cat-state-label');

      // Blinking logic
      cat.blinkTimer--;
      if (cat.blinkTimer <= 0) {
        cat.isBlinking = true;
        if (cat.blinkTimer < -8) {
          cat.isBlinking = false;
          cat.blinkTimer = 140 + Math.random() * 180;
        }
      }
      if (cat.petSquintTimer > 0) cat.petSquintTimer--;
      if (cat.stretchFactor > 0) cat.stretchFactor *= 0.9;
      if (cat.pounceCooldown > 0) cat.pounceCooldown--;

      // Update falling snacks physics toward the top of the card
      const cardRect = cardEl.getBoundingClientRect();
      for (let i = 0; i < state.snacks.length; i++) {
        const s = state.snacks[i];
        if (s.y < s.targetY) {
          s.vy = (s.vy || 0) + 0.45;
          s.y = Math.min(s.targetY, s.y + s.vy);
        }
      }

      // Priority 1: Chase snacks if any exist
      if (state.snacks.length > 0) {
        const targetSnack = state.snacks[0];
        const dx = targetSnack.x - cat.x;
        const dy = targetSnack.y - cat.y;
        const dist = Math.hypot(dx, dy);

        statusLabel.textContent = 'cat: hunting snack';
        if (Math.abs(dx) > 3) cat.facing = dx > 0 ? 1 : -1;

        if (dist > 14) {
          const accel = 0.68 * state.catSpeedMultiplier;
          cat.vx += (dx / dist) * accel;
          cat.vy += (dy / dist) * accel;
        } else {
          state.snacks.shift();
          cat.petSquintTimer = 45;
          cat.stretchFactor = 0.7;
          playPurrSynth();
          spawnRipple(cat.x, cat.y, 10);
        }

        cat.vx *= 0.84;
        cat.vy *= 0.84;
        cat.x += cat.vx;
        cat.y += cat.vy;

      } else if (state.laserActive) {
        // Priority 2: Chase laser pointer across the screen
        cat.mode = 'chasing';
        const dx = state.mouseX - cat.x;
        const dy = state.mouseY - cat.y;
        const dist = Math.hypot(dx, dy);

        if (Math.abs(dx) > 4) {
          cat.facing = dx > 0 ? 1 : -1;
        }

        if (dist > 18) {
          let boost = 1;
          if (dist < 140 && dist > 45 && cat.pounceCooldown === 0 && Math.random() < 0.035) {
            boost = 3.8;
            cat.pounceCooldown = 65;
          }

          const accel = 0.72 * state.catSpeedMultiplier * boost;
          cat.vx += (dx / dist) * accel;
          cat.vy += (dy / dist) * accel;
          statusLabel.textContent = boost > 1 ? 'cat: pouncing!' : 'cat: chasing laser';
        } else {
          statusLabel.textContent = 'cat: caught dot';
          if (Math.random() < 0.08) {
            cat.vx += (Math.random() - 0.5) * 4;
            cat.vy += (Math.random() - 0.5) * 4;
          }
        }

        cat.vx *= 0.87;
        cat.vy *= 0.87;
        cat.x += cat.vx;
        cat.y += cat.vy;

        cat.x = Math.max(24, Math.min(window.innerWidth - 24, cat.x));
        cat.y = Math.max(30, Math.min(window.innerHeight - 16, cat.y));

      } else {
        // Priority 3: Return to perch on top edge of the card
        const dx = perch.x - cat.x;
        const dy = perch.y - cat.y;
        const dist = Math.hypot(dx, dy);

        if (dist > 4) {
          cat.mode = 'returning';
          statusLabel.textContent = 'cat: returning to perch';
          cat.facing = dx > 0 ? 1 : -1;
          const speed = Math.min(dist * 0.12, 6.5 * state.catSpeedMultiplier);
          cat.vx = (dx / dist) * speed;
          cat.vy = (dy / dist) * speed;
          cat.x += cat.vx;
          cat.y += cat.vy;
        } else {
          cat.mode = 'perched';
          cat.x = perch.x;
          cat.y = perch.y;
          cat.vx = 0;
          cat.vy = 0;
          if (Math.abs(state.mouseX - cat.x) > 20) {
            cat.facing = state.mouseX > cat.x ? 1 : -1;
          }
          statusLabel.textContent = cat.petSquintTimer > 0 ? 'cat: purring' : 'cat: watching cursor';
        }
      }

      // Walk cycle animation
      const speedMag = Math.hypot(cat.vx, cat.vy);
      if (speedMag > 0.4) {
        cat.walkCycle += speedMag * 0.16;
      } else {
        cat.walkCycle = 0;
      }

      // Multi-segment tail physics
      const tailBaseX = cat.x - cat.facing * 14;
      const tailBaseY = cat.y - 6;
      cat.tail[0].x = tailBaseX;
      cat.tail[0].y = tailBaseY;

      const sway = Math.sin(time * 0.004) * (cat.mode === 'chasing' ? 2.5 : 1.2);

      for (let i = 1; i < cat.tail.length; i++) {
        const prev = cat.tail[i - 1];
        const cur = cat.tail[i];

        if (speedMag < 0.6) {
          cur.x += (-cat.facing * 2.2 + sway * 0.4 - (cur.x - prev.x)) * 0.25;
          cur.y += (-3.8 + Math.cos(time * 0.003 + i) * 0.5 - (cur.y - prev.y)) * 0.25;
        }

        const tdx = cur.x - prev.x;
        const tdy = cur.y - prev.y;
        const tDist = Math.hypot(tdx, tdy) || 1;
        const segLen = 5.5;

        cur.x = prev.x + (tdx / tDist) * segLen;
        cur.y = prev.y + (tdy / tDist) * segLen;
      }
    }

    function drawCatAndOverlay(time) {
      catCtx.clearRect(0, 0, catCanvas.width, catCanvas.height);

      // 1. Draw dropped snacks
      for (let i = 0; i < state.snacks.length; i++) {
        const s = state.snacks[i];
        catCtx.save();
        catCtx.translate(s.x, s.y);
        catCtx.fillStyle = '#e5e5e5';
        catCtx.strokeStyle = '#0a0a0a';
        catCtx.lineWidth = 1;
        catCtx.beginPath();
        catCtx.ellipse(0, -3, 6, 3.2, 0, 0, Math.PI * 2);
        catCtx.moveTo(-5, -3);
        catCtx.lineTo(-9, -6.5);
        catCtx.lineTo(-9, 0.5);
        catCtx.closePath();
        catCtx.fill();
        catCtx.stroke();
        catCtx.restore();
      }

      // 2. Draw Laser Dot if active
      if (state.laserActive) {
        catCtx.save();
        catCtx.fillStyle = '#ffffff';
        catCtx.beginPath();
        catCtx.arc(state.mouseX, state.mouseY, 3.5, 0, Math.PI * 2);
        catCtx.fill();

        catCtx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
        catCtx.lineWidth = 1;
        catCtx.beginPath();
        catCtx.arc(state.mouseX, state.mouseY, 7 + Math.sin(time * 0.02) * 1.5, 0, Math.PI * 2);
        catCtx.stroke();
        catCtx.restore();
      }

      // 3. Draw the Cat
      catCtx.save();

      // Draw Tail behind body
      catCtx.beginPath();
      catCtx.moveTo(cat.tail[0].x, cat.tail[0].y);
      for (let i = 1; i < cat.tail.length; i++) {
        catCtx.lineTo(cat.tail[i].x, cat.tail[i].y);
      }
      catCtx.strokeStyle = '#525252';
      catCtx.lineWidth = 5;
      catCtx.lineCap = 'round';
      catCtx.lineJoin = 'round';
      catCtx.stroke();

      catCtx.strokeStyle = '#141414';
      catCtx.lineWidth = 3;
      catCtx.stroke();

      // Body transform (squish/stretch)
      const speedMag = Math.hypot(cat.vx, cat.vy);
      const stretchY = 1 + cat.stretchFactor * 0.28;
      const stretchX = 1 - cat.stretchFactor * 0.12 + Math.min(speedMag * 0.025, 0.22);

      catCtx.translate(cat.x, cat.y);
      catCtx.scale(stretchX, stretchY);

      // Legs
      catCtx.strokeStyle = '#525252';
      catCtx.fillStyle = '#141414';
      catCtx.lineWidth = 3;
      catCtx.lineCap = 'round';

      if (speedMag > 0.5) {
        const legSwing1 = Math.sin(cat.walkCycle) * 5;
        const legSwing2 = Math.cos(cat.walkCycle) * 5;
        catCtx.beginPath();
        catCtx.moveTo(-cat.facing * 9, -4);
        catCtx.lineTo(-cat.facing * 9 + legSwing1, 2);
        catCtx.moveTo(-cat.facing * 5, -4);
        catCtx.lineTo(-cat.facing * 5 - legSwing1, 2);
        catCtx.moveTo(cat.facing * 7, -4);
        catCtx.lineTo(cat.facing * 7 + legSwing2, 2);
        catCtx.moveTo(cat.facing * 10, -4);
        catCtx.lineTo(cat.facing * 10 - legSwing2, 2);
        catCtx.stroke();
      } else {
        // Neat sitting paws on the card top border
        catCtx.fillStyle = '#e5e5e5';
        catCtx.beginPath();
        catCtx.arc(cat.facing * 6, -1, 2.2, 0, Math.PI * 2);
        catCtx.arc(cat.facing * 10, -1, 2.2, 0, Math.PI * 2);
        catCtx.fill();
      }

      // Main Body Silhouette
      catCtx.fillStyle = '#141414';
      catCtx.strokeStyle = '#525252';
      catCtx.lineWidth = 1.25;

      catCtx.beginPath();
      catCtx.ellipse(0, -9, 14, 8.5, 0, 0, Math.PI * 2);
      catCtx.fill();
      catCtx.stroke();

      // Head position
      const headBob = speedMag > 0.5 ? Math.abs(Math.sin(cat.walkCycle)) * 1.5 : 0;
      const hx = cat.facing * 10;
      const hy = -16 - headBob;

      // Pointy Ears
      catCtx.beginPath();
      catCtx.moveTo(hx - 7, hy - 5);
      catCtx.lineTo(hx - 9, hy - 14);
      catCtx.lineTo(hx - 2, hy - 8);
      catCtx.moveTo(hx + 2, hy - 8);
      catCtx.lineTo(hx + 9, hy - 14);
      catCtx.lineTo(hx + 7, hy - 5);
      catCtx.fill();
      catCtx.stroke();

      // Head Circle
      catCtx.beginPath();
      catCtx.arc(hx, hy, 9, 0, Math.PI * 2);
      catCtx.fill();
      catCtx.stroke();

      // Eyes Tracking Cursor
      const eyeCenterX = hx + cat.facing * 2;
      const eyeY = hy - 1;
      const leftEyeX = eyeCenterX - 3.3;
      const rightEyeX = eyeCenterX + 3.3;

      if (cat.petSquintTimer > 0) {
        // Happy squinting ^ ^ eyes when petted
        catCtx.strokeStyle = '#e5e5e5';
        catCtx.lineWidth = 1.3;
        catCtx.beginPath();
        catCtx.moveTo(leftEyeX - 2, eyeY + 1);
        catCtx.lineTo(leftEyeX, eyeY - 1.5);
        catCtx.lineTo(leftEyeX + 2, eyeY + 1);
        catCtx.moveTo(rightEyeX - 2, eyeY + 1);
        catCtx.lineTo(rightEyeX, eyeY - 1.5);
        catCtx.lineTo(rightEyeX + 2, eyeY + 1);
        catCtx.stroke();
      } else if (cat.isBlinking) {
        catCtx.strokeStyle = '#e5e5e5';
        catCtx.lineWidth = 1.2;
        catCtx.beginPath();
        catCtx.moveTo(leftEyeX - 2, eyeY);
        catCtx.lineTo(leftEyeX + 2, eyeY);
        catCtx.moveTo(rightEyeX - 2, eyeY);
        catCtx.lineTo(rightEyeX + 2, eyeY);
        catCtx.stroke();
      } else {
        catCtx.fillStyle = '#e5e5e5';
        catCtx.beginPath();
        catCtx.arc(leftEyeX, eyeY, 2.3, 0, Math.PI * 2);
        catCtx.arc(rightEyeX, eyeY, 2.3, 0, Math.PI * 2);
        catCtx.fill();

        // Pupils looking toward cursor
        const angleToMouse = Math.atan2(state.mouseY - (cat.y + hy), state.mouseX - (cat.x + hx));
        const px = Math.cos(angleToMouse) * 0.9;
        const py = Math.sin(angleToMouse) * 0.9;

        catCtx.fillStyle = '#0a0a0a';
        catCtx.beginPath();
        catCtx.arc(leftEyeX + px, eyeY + py, 1.1, 0, Math.PI * 2);
        catCtx.arc(rightEyeX + px, eyeY + py, 1.1, 0, Math.PI * 2);
        catCtx.fill();
      }

      // Whiskers
      catCtx.strokeStyle = '#525252';
      catCtx.lineWidth = 0.8;
      catCtx.beginPath();
      catCtx.moveTo(hx - 7, hy + 1);
      catCtx.lineTo(hx - 12, hy);
      catCtx.moveTo(hx - 7, hy + 3);
      catCtx.lineTo(hx - 12, hy + 4);
      catCtx.moveTo(hx + 7, hy + 1);
      catCtx.lineTo(hx + 12, hy);
      catCtx.moveTo(hx + 7, hy + 3);
      catCtx.lineTo(hx + 12, hy + 4);
      catCtx.stroke();

      catCtx.restore();
    }

    /* =========================================================================
       3. INTERACTION & UI HANDLERS
       ========================================================================= */
    window.addEventListener('mousemove', (e) => {
      state.mouseX = e.clientX;
      state.mouseY = e.clientY;
    });

    window.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        state.mouseX = e.touches[0].clientX;
        state.mouseY = e.touches[0].clientY;
      }
    }, { passive: true });

    window.addEventListener('mousedown', (e) => {
      state.mouseX = e.clientX;
      state.mouseY = e.clientY;

      // Check if user clicked directly on the cat
      const distToCat = Math.hypot(e.clientX - cat.x, e.clientY - (cat.y - 12));
      if (distToCat < 32) {
        petCat();
        return;
      }

      // If clicked outside the main card, emit an ASCII grid ripple wave
      const cardRect = cardEl.getBoundingClientRect();
      const insideCard =
        e.clientX >= cardRect.left &&
        e.clientX <= cardRect.right &&
        e.clientY >= cardRect.top &&
        e.clientY <= cardRect.bottom;

      if (!insideCard) {
        spawnRipple(e.clientX, e.clientY, 16);
        playClickTick(140);
      }
    });

    function petCat() {
      if (cat.mode === 'napping') {
        cat.mode = 'perched';
      }
      state.petCount++;
      document.getElementById('pet-count-label').textContent = `pets: ${state.petCount}`;
      cat.petSquintTimer = 55;
      cat.stretchFactor = 1.0;
      playPurrSynth();
      spawnRipple(cat.x, cat.y, 9);
    }

    function toggleLaser() {
      state.laserActive = !state.laserActive;
      const btn = document.getElementById('laser-btn');
      const btnText = document.getElementById('laser-btn-text');
      const dot = document.getElementById('laser-dot-indicator');

      if (state.laserActive) {
        if (cat.mode === 'napping') {
          cat.mode = 'chasing';
        }
        document.body.classList.add('laser-active');
        btn.classList.add('active');
        btnText.textContent = 'laser: on';
        dot.className = 'w-1.5 h-1.5 rounded-full bg-[#0a0a0a]';
        playSoftChirp();
      } else {
        document.body.classList.remove('laser-active');
        btn.classList.remove('active');
        btnText.textContent = 'laser: off';
        dot.className = 'w-1.5 h-1.5 rounded-full bg-[#737373]';
        playClickTick(220);
      }
    }

    function feedCatFish() {
      const rect = cardEl.getBoundingClientRect();
      // Drop a snack from above onto a random spot along the top edge of the card
      const snackX = rect.left + 30 + Math.random() * (rect.width - 120);
      const snackY = rect.top - 45;
      state.snacks.push({ x: snackX, y: snackY, targetY: rect.top, vy: 0 });
      if (cat.mode === 'napping') {
        cat.mode = 'perched';
      }
      playSoftChirp();
      spawnRipple(snackX, rect.top, 8);
    }

    function toggleAudio() {
      state.sfxEnabled = !state.sfxEnabled;
      const btn = document.getElementById('audio-btn');
      btn.textContent = state.sfxEnabled ? 'sfx: on' : 'sfx: off';
      if (state.sfxEnabled) playClickTick(260);
    }

    // Clipboard copy with inline status confirmation
    const copyTimers = {};
    function copyHandle(text, statusElementId) {
      const el = document.getElementById(statusElementId);
      const doFeedback = () => {
        playClickTick(320);
        el.textContent = '[copied]';
        el.style.color = '#e5e5e5';
        el.style.borderColor = '#525252';
        clearTimeout(copyTimers[statusElementId]);
        copyTimers[statusElementId] = setTimeout(() => {
          el.textContent = '[copy]';
          el.style.color = '';
          el.style.borderColor = '';
        }, 1600);
      };

      const temp = document.createElement('textarea');
      temp.value = text;
      temp.style.position = 'fixed';
      temp.style.opacity = '0';
      document.body.appendChild(temp);
      temp.select();
      try {
        document.execCommand('copy');
        doFeedback();
      } catch (err) {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(text).then(doFeedback);
        }
      }
      document.body.removeChild(temp);
    }

    // Live 24-hour clock
    function updateClock() {
      const now = new Date();
      const hrs = String(now.getHours()).padStart(2, '0');
      const mins = String(now.getMinutes()).padStart(2, '0');
      const secs = String(now.getSeconds()).padStart(2, '0');
      document.getElementById('clock-label').textContent = `${hrs}:${mins}:${secs}`;
    }
    setInterval(updateClock, 1000);
    updateClock();

    window.addEventListener('resize', () => {
      initGrid();
      initCat();
    });

    /* =========================================================================
       MAIN ANIMATION LOOP
       ========================================================================= */
    function animate(time) {
      updateAndDrawGrid();
      updateCatPhysics(time);
      drawCatAndOverlay(time);
      requestAnimationFrame(animate);
    }

    window.onload = () => {
      initGrid();
      initCat();
      requestAnimationFrame(animate);
    };
  </script>
</body>
