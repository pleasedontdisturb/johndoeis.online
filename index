    <!-- About / What I Do -->
    <section class="space-y-2.5">
      <div class="flex items-center justify-between text-[11px] mono text-[#737373]">
        <span>// info</span>
        <span>loc: local</span>
      </div>
      <p class="text-xs sm:text-[13px] text-[#a3a3a3] leading-relaxed">
        yah this is my website, im tajik and im level 9999 opsec like mr robot no cap
      </p>
      <div class="flex flex-wrap gap-1.5 pt-1 mono text-[11px] text-[#a3a3a3]">
        <span class="px-2 py-0.5 bg-[#161616] border border-[#262626]">tajik</span>
