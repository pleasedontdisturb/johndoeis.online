<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>john doe</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-base: #0a0a0a;
      --bg-card: #111111;
      --bg-elevated: #161616;
      --bg-hover: #1f1f1f;
      --border: #262626;
      --border-light: #3a3a3a;
      --text-main: #e5e5e5;
      --text-muted: #a3a3a3;
      --text-dim: #737373;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mono {
      font-family: 'JetBrains Mono', monospace;
    }

    /* Hide native cursor when laser mode is active */
    body.laser-active,
    body.laser-active button,
    body.laser-active a {
      cursor: none;
    }

    /* Main container card */
    .main-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.85);
    }

    .interactive-row {
      background-color: #141414;
      border: 1px solid var(--border);
      transition: background-color 0.12s ease, border-color 0.12s ease, transform 0.08s ease;
    }

    .interactive-row:hover {
      background-color: var(--bg-hover);
      border-color: var(--border-light);
    }

    .interactive-row:active {
      transform: translateY(1px);
    }

    .btn-raw {
      background-color: #161616;
      border: 1px solid var(--border);
      color: var(--text-muted);
      transition: all 0.12s ease;
    }

    .btn-raw:hover {
      background-color: #222222;
      color: var(--text-main);
      border-color: var(--border-light);
    }

    .btn-raw:active {
      transform: translateY(1px);
    }

    .btn-raw.active {
      background-color: #e5e5e5;
      color: #0a0a0a;
      border-color: #e5e5e5;
      font-weight: 500;
    }
  </style>
</head>
<body class="p-4 sm:p-6 relative">

  <!-- Background ASCII/Dot Physics Canvas -->
  <canvas id="bg-canvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

  <!-- Foreground Cat & Laser Overlay Canvas -->
