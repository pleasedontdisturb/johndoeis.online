  <!-- Centered Single-Screen Card -->
  <main id="card-container" class="main-card w-full max-w-[490px] relative z-10 p-5 sm:p-6 flex flex-col gap-5 mt-8">

    <!-- Top Header -->
    <header class="flex items-start justify-between border-b border-[#262626] pb-4 gap-2">
      <div>
        <div class="flex items-center gap-2.5">
          <h1 class="text-lg font-semibold tracking-tight text-[#e5e5e5] mono">john doe</h1>
          <span class="w-1.5 h-1.5 rounded-full bg-[#737373] inline-block" title="status: online"></span>
          <span class="text-[11px] mono text-[#737373] px-1.5 py-0.5 bg-[#181818] border border-[#262626]">idx.01</span>
        </div>
