    <!-- Minimal Footer / Status Bar -->
    <footer class="border-t border-[#262626] pt-3 flex flex-wrap items-center justify-between gap-2 text-[11px] mono text-[#737373]">
      <div class="flex items-center gap-2">
        <span id="status-dot" class="w-1.5 h-1.5 bg-[#a3a3a3] inline-block rounded-full"></span>
        <span id="cat-state-label">cat: perched</span>
      </div>
      <div class="flex items-center gap-2.5">
        <button onclick="petCat()" class="hover:text-[#e5e5e5] transition" title="click the cat or here to pet">
          <span id="pet-count-label">pets: 0</span>
        </button>
        <span>•</span>
        <button onclick="toggleAudio()" id="audio-btn" class="hover:text-[#e5e5e5] transition">
          sfx: on
        </button>
        <span>•</span>
        <span id="clock-label">00:00:00</span>
      </div>
